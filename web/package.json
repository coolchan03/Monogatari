{
  "name": "monogatari-web",
  "version": "1.9.0",
  "private": true,
  "description": "Monogatari for the web (PWA) and Windows (Electron)",
  "author": "Monogatari contributors",
  "license": "GPL-3.0-only",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:sandbox && vite",
    "build:sandbox": "vite build -c vite.sandbox.config.ts",
    "build": "npm run build:sandbox && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "e2e": "node e2e/smoke.mjs && node e2e/manga.mjs"
  },
  "devDependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@preact/preset-vite": "2.10.2",
    "electron": "37.2.0",
    "electron-builder": "26.0.12",
    "fflate": "0.8.2",
    "hls.js": "1.6.2",
    "jsdom": "26.1.0",
    "playwright": "1.54.2",
    "preact": "10.26.9",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "io.github.coolchan03.monogatari.desktop",
    "productName": "Monogatari",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Monogatari-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Monogatari-Portable-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/coolchan03/Monogatari"
}
