     private fun extractPageProps(doc: org.jsoup.nodes.Document): JSONObject? {
         val raw = doc.selectFirst("script#__NEXT_DATA__")?.data() ?: return null
         return runCatching {
-            JSONObject(raw).optJSONObject("props")?.optJSONObject("pageProps")
+            val props = JSONObject(raw).optJSONObject("props")?.optJSONObject("pageProps") ?: return@runCatching null
+            // softkomik.app CryptoJS-encrypts the details and chapter data in `_stk`; older mirrors send it as is.
+            val stk = props.optString("_stk", "")
+            if (stk.isEmpty()) props else JSONObject(decryptStk(stk))
         }.getOrNull()
     }
+
+    /** CryptoJS.AES.decrypt(payload, passphrase): OpenSSL "Salted__" container, MD5 EVP_BytesToKey, AES-256-CBC. */
+    private fun decryptStk(payload: String): String {
+        val raw = Base64.getMimeDecoder().decode(payload.trim())
+        require(raw.size > 16 && String(raw, 0, 8, Charsets.ISO_8859_1) == "Salted__") { "Missing Salted__ header" }
+        val salt = raw.copyOfRange(8, 16)
+        val pass = PAGE_PROPS_KEY.toByteArray(Charsets.UTF_8)
+        val md = MessageDigest.getInstance("MD5")
+        val keyIv = ByteArrayOutputStream()
+        var block = ByteArray(0)
+        while (keyIv.size() < 48) {
+            md.reset()
+            md.update(block)
+            md.update(pass)
+            md.update(salt)
+            block = md.digest()
+            keyIv.write(block)
+        }
+        val kd = keyIv.toByteArray()
+        val cipher = Cipher.getInstance("AES/CBC/PKCS5Padding")
+        cipher.init(Cipher.DECRYPT_MODE, SecretKeySpec(kd, 0, 32, "AES"), IvParameterSpec(kd, 32, 16))
+        return String(cipher.doFinal(raw, 16, raw.size - 16), Charsets.UTF_8)
+    }
+
+    private fun String.titleCase(): String = split(' ').joinToString(" ") { w ->
+        w.replaceFirstChar { c -> if (c.isLowerCase()) c.titlecase(Locale.ROOT) else c.toString() }
+    }
+
+    private fun String.cleanB64(): String =
+        substringBefore('=').let { it + "=".repeat((4 - (it.length % 4)) % 4) }
+
+    private companion object {
+        // NEXT_PUBLIC_ENCRYPTION_KEY from the site's JS bundle (also used by the Keiyoushi extension).
+        const val PAGE_PROPS_KEY = "nYTInq9MwR4pWa8yeXtu/2iO3t9nGP65WHpWEvqpEdU="
+
+        // Inlined in the site's chapter chunk and appended to every image URL.
+        const val IMAGE_ID_PARAM = "T4Kmwztku"
+    }
