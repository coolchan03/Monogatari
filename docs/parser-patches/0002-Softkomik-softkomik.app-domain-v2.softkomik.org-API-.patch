+     */
+    private suspend fun apiJson(url: String, referer: String, session: suspend () -> SessionDto): JSONObject {
+        val plain = Headers.Builder()
+            .add("Accept", "application/json")
+            .add("Referer", referer)
+            .add("Origin", "https://$domain")
+            .build()
+        val first = runCatchingCancellable { webClient.httpGet(url, plain).parseJson() }
+        first.getOrNull()?.let { return it }
+        val withSession = runCatchingCancellable {
+            val s = session()
+            val headers = plain.newBuilder().add("X-Token", s.token).add("X-Sign", s.sign).build()
+            webClient.httpGet(url, headers).parseJson()
+        }
+        return withSession.getOrNull() ?: throw first.exceptionOrNull()!!
+    }
 
