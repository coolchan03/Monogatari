@@ -15,7 +16,10 @@ import kotlin.random.Random
 
 @MangaSourceParser("AQUAMANGA", "AquaManga", "en")
 internal class AquaManga(context: MangaLoaderContext) :
-	MadaraParser(context, MangaParserSource.AQUAMANGA, "aquareader.org", 20) {
