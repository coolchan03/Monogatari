+package org.koitharu.kotatsu.parsers.regression
+
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.koitharu.kotatsu.parsers.model.Manga
+import org.koitharu.kotatsu.parsers.model.MangaParserSource
+import org.koitharu.kotatsu.parsers.MangaLoaderContextMock
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Live regression test: MangaDotNet returns chapter ids as JSON numbers and accepts stored (bare id) and resolved
+ * (`/manga/<id>`) urls. Uses a long-running series that always has chapters.
+ */
+internal class MangadotnetChaptersTest {
+
+	private val parser = MangaLoaderContextMock.newParserInstance(MangaParserSource.MANGADOTNET)
+
+	private fun stub(url: String) = Manga(
+		id = 1L, title = "", altTitles = emptySet(), url = url, publicUrl = "", rating = -1f, contentRating = null,
+		coverUrl = null, tags = emptySet(), state = null, authors = emptySet(), source = MangaParserSource.MANGADOTNET,
+	)
+
+	@Test
+	fun chaptersAndPagesWithNumericIds() = runTest(timeout = 2.minutes) {
+		val details = parser.getDetails(stub("41"))
+		val chapters = details.chapters.orEmpty()
+		assertTrue(chapters.isNotEmpty(), "no chapters returned")
+		val pages = parser.getPages(chapters.first())
+		assertTrue(pages.isNotEmpty(), "no pages returned")
+	}
+
+	@Test
+	fun resolvedUrlFormIsAccepted() = runTest(timeout = 2.minutes) {
+		val details = parser.getDetails(stub("/manga/41"))
+		assertTrue(details.chapters.orEmpty().isNotEmpty(), "no chapters for /manga/<id> url")
+	}
+}
