@@ -539,6 +540,19 @@ internal class Mangadotnet(context: MangaLoaderContext) :
 
 	// region Helpers
 
+	/**
+	 * The site returns chapter ids as JSON numbers, older stored urls hold them as strings. Strict JSON parsers
+	 * (org.json on the JVM) throw on getString for a number, so accept both and keep the id text unchanged.
+	 */
+	private fun JSONObject.requireIdString(): String = when (val raw = opt("id")) {
+		is String -> raw.trim().nullIfEmpty()
+		is Number -> if (raw.toDouble() % 1.0 == 0.0) raw.toLong().toString() else raw.toString()
+		else -> null
+	} ?: throw org.json.JSONException("Chapter id is missing")
+
+	/** Stored urls are bare ids; links resolved from the website arrive as `/manga/<id>`. Accept both. */
+	private fun String.toMangaId(): String = substringBefore('?').trimEnd('/').substringAfterLast('/')
+
 	private fun String.toCoverUrl(): String? = when {
 		startsWith("/") -> "$baseUrl$this"
 		startsWith("http") -> this
