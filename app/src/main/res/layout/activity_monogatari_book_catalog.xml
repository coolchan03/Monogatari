<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/monogatari_catalog_title"
        android:textAppearance="?attr/textAppearanceHeadlineMedium" />
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/monogatari_catalog_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <ImageView android:id="@+id/monogatari_catalog_mascot"
            android:layout_width="64dp" android:layout_height="64dp"
            android:layout_marginStart="8dp" android:scaleType="fitCenter"
            android:contentDescription="@string/mascot_book" />
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/monogatari_catalog_query"
        app:boxBackgroundMode="outline">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/monogatari_catalog_query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/monogatari_catalog_search_sources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:minHeight="48dp"
        android:text="@string/monogatari_catalog_search_sources" />
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/monogatari_catalog_all"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Search all catalogs" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/monogatari_catalog_sort"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="Best match" />
    </LinearLayout>
    <TextView android:id="@+id/monogatari_catalog_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingVertical="6dp" android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
    <HorizontalScrollView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_gutenberg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monogatari_catalog_gutenberg" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_openlibrary"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_open_library" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_archive"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_archive" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_wikisource"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Wikisource" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_google"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="Google Books previews" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_standard_ebooks"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/monogatari_catalog_standard_ebooks" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_more_public"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_more_public" />
        </LinearLayout>
    </HorizontalScrollView>
    <HorizontalScrollView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monogatari_catalog_import" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_mybooks"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_local" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_filter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_filter" />
        </LinearLayout>
    </HorizontalScrollView>
    <HorizontalScrollView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_opds_open"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monogatari_catalog_opds_open" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_opds_save"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_opds_save" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/monogatari_catalog_opds_saved"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/monogatari_catalog_opds_saved" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/monogatari_catalog_results"
        android:textAppearance="?attr/textAppearanceTitleMedium" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monogatari_catalog_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />
</LinearLayout>
