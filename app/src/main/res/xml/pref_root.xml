<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        A short list of groups; each one opens its own page. The groups only link to the existing screens,
        so every preference keeps its key and its screen (settings search still finds them all).
    -->
    <Preference
        android:key="monogatari_settings_intro"
        android:layout="@layout/preference_monogatari_settings_header"
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:title="@string/monogatari_settings_intro_title"
        android:summary="@string/monogatari_settings_intro_summary" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.AppearanceSettingsFragment"
        android:icon="@drawable/ic_appearance"
        android:key="appearance"
        android:summary="@string/settings_group_appearance_summary"
        android:title="@string/settings_group_appearance" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.ReaderSettingsFragment"
        android:icon="@drawable/ic_book_page"
        android:key="reader"
        android:summary="@string/settings_group_reading_summary"
        android:title="@string/settings_group_reading" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.LibrarySettingsGroupFragment"
        android:icon="@drawable/ic_download"
        android:key="monogatari_group_library"
        android:summary="@string/settings_group_library_summary"
        android:title="@string/settings_group_library" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.SourcesSettingsGroupFragment"
        android:icon="@drawable/ic_monogatari_nav_explore"
        android:key="monogatari_group_sources"
        android:summary="@string/settings_group_sources_summary"
        android:title="@string/settings_group_sources" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.DiscoverSettingsGroupFragment"
        android:icon="@drawable/ic_suggestion"
        android:key="monogatari_group_discover"
        android:summary="@string/settings_group_discover_summary"
        android:title="@string/settings_group_discover" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.NotificationsSettingsGroupFragment"
        android:icon="@drawable/ic_monogatari_nav_updated"
        android:key="monogatari_group_notifications"
        android:summary="@string/settings_group_notifications_summary"
        android:title="@string/settings_group_notifications" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.BackupSettingsGroupFragment"
        android:icon="@drawable/ic_backup_restore"
        android:key="monogatari_group_backup"
        android:summary="@string/settings_group_backup_summary"
        android:title="@string/settings_group_backup" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.PrivacySettingsGroupFragment"
        android:icon="@drawable/ic_lock"
        android:key="monogatari_group_privacy"
        android:summary="@string/settings_group_privacy_summary"
        android:title="@string/settings_group_privacy" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.AdvancedSettingsFragment"
        android:icon="@drawable/ic_services"
        android:key="monogatari_advanced_entry"
        android:summary="@string/settings_group_advanced_summary"
        android:title="@string/settings_group_advanced" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.about.AboutSettingsFragment"
        android:icon="@drawable/ic_info_outline"
        android:key="about"
        android:title="@string/about" />

</PreferenceScreen>
