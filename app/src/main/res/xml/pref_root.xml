<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Flat preference hierarchy deliberately preserves settings-search navigation. -->
    <Preference
        android:key="monogatari_settings_intro"
        android:layout="@layout/preference_monogatari_settings_header"
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:title="@string/monogatari_settings_intro_title"
        android:summary="@string/monogatari_settings_intro_summary" />

    <Preference
        android:layout="@layout/preference_monogatari_settings_section"
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:title="@string/monogatari_settings_customize" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.AppearanceSettingsFragment"
        android:icon="@drawable/ic_appearance"
        android:key="appearance"
        android:title="@string/appearance" />

    <Preference
        android:layout="@layout/preference_monogatari_settings_section"
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:title="@string/monogatari_settings_discover" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.sources.SourcesSettingsFragment"
        android:icon="@drawable/ic_monogatari_nav_explore"
        android:key="remote_sources"
        android:title="@string/remote_sources" />

    <Preference
        android:key="monogatari_books_entry"
        android:icon="@drawable/ic_monogatari_nav_books"
        android:title="@string/monogatari_settings_books_title"
        android:summary="@string/monogatari_settings_books_summary" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.ReaderSettingsFragment"
        android:icon="@drawable/ic_book_page"
        android:key="reader"
        android:title="@string/reader_settings" />

    <Preference
        android:layout="@layout/preference_monogatari_settings_section"
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:title="@string/monogatari_settings_manage" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.StorageAndNetworkSettingsFragment"
        android:icon="@drawable/ic_usage"
        android:key="network"
        android:title="@string/storage_and_network" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.DownloadsSettingsFragment"
        android:icon="@drawable/ic_download"
        android:key="downloads"
        android:title="@string/downloads" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.tracker.TrackerSettingsFragment"
        android:icon="@drawable/ic_monogatari_nav_updated"
        android:key="tracker"
        android:title="@string/check_for_new_chapters" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.ServicesSettingsFragment"
        android:icon="@drawable/ic_services"
        android:key="services"
        android:title="@string/services" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.userdata.BackupsSettingsFragment"
        android:icon="@drawable/ic_backup_restore"
        android:key="userdata"
        android:title="@string/backup_restore" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.AdvancedSettingsFragment"
        android:icon="@drawable/ic_monogatari_nav_explore"
        android:key="monogatari_advanced_entry"
        android:title="@string/monogatari_advanced_title" />

    <PreferenceScreen
        android:fragment="org.koitharu.kotatsu.settings.about.AboutSettingsFragment"
        android:icon="@drawable/ic_info_outline"
        android:key="about"
        android:title="@string/about" />

</PreferenceScreen>
