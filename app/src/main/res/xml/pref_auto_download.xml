<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/auto_download_recommendations">

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:key="enabled"
		android:summary="@string/auto_download_enable_summary"
		android:title="@string/auto_download_enable" />

	<Preference
		android:key="setup"
		android:persistent="false"
		android:title="@string/auto_download_setup" />

	<Preference
		android:key="usage"
		android:persistent="false"
		android:selectable="false"
		android:title="@string/auto_download_usage" />

	<Preference
		android:key="remove"
		android:persistent="false"
		android:summary="@string/auto_download_remove_summary"
		android:title="@string/auto_download_remove" />

	<Preference
		android:icon="@drawable/ic_info_outline"
		android:key="info"
		android:persistent="false"
		android:selectable="false"
		android:summary="@string/auto_download_info"
		app:allowDividerAbove="true" />

</PreferenceScreen>
