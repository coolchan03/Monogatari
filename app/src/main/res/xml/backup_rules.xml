<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
	<cloud-backup disableIfNoEncryptionCapabilities="false">
		<include
			domain="sharedpref"
			path="." />
		<exclude
			domain="sharedpref"
			path="_local_index.xml" />
		<exclude domain="sharedpref" path="monogatari_backup_identity.xml" />
        <exclude domain="sharedpref" path="monogatari_js_source_updates.xml" />
        <exclude domain="sharedpref" path="monogatari_default_presets.xml" />
        <exclude domain="database" />
		<exclude domain="device_database" />
		<exclude domain="external" />
	</cloud-backup>
	<device-transfer>
		<include
			domain="sharedpref"
			path="." />
		<exclude
			domain="sharedpref"
			path="_local_index.xml" />
		<exclude domain="sharedpref" path="monogatari_backup_identity.xml" />
        <exclude domain="sharedpref" path="monogatari_js_source_updates.xml" />
        <exclude domain="sharedpref" path="monogatari_default_presets.xml" />
        <exclude domain="database" />
		<exclude domain="device_database" />
	</device-transfer>
</data-extraction-rules>
